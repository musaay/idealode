# IdeaLode konfigürasyonu — tamamı ortam değişkeni; config dosyası YOK (V1 kararı).
# Kaynak listesi DB-backed'dir (idealode.sources), env'de tutulmaz.

# --- Zorunlu ---------------------------------------------------------------
# Veriler `idealode` Postgres şemasında yaşar (bağlantıda search_path=idealode
# set edilir); mevcut bir instance güvenle paylaşılabilir.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- LLM (analyze/synthesize/generate için zorunlu) -------------------------
# Sağlayıcı env ile seçilir (#96) — OpenAI-uyumlu chat-completions endpoint'i
# sunan herhangi bir sağlayıcıya kod değişikliği olmadan geçilebilir.
LLM_API_KEY=
# Varsayılan: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Varsayılan: openai/gpt-oss-120b
LLM_MODEL=
# Geriye uyumluluk: LLM_API_KEY/LLM_MODEL boşsa bu eski isimlere düşülür
# (Railway'de mevcut env bozulmasın). Yeni kurulumlarda yukarıdakiler kullanılsın.
GROQ_API_KEY=
GROQ_MODEL=

# --- Özgünlük merceği için AYRI istemci (opsiyonel, #166) -------------------
# Yalnız özgünlük merceğini (evaluateDistinctiveness) farklı bir sağlayıcıya/
# modele taşımak için — üçü de doluysa kullanılır (canlıda: Gemini 3.5 Flash
# Lite, OpenAI-uyumlu uç). Biri eksikse özgünlük de yukarıdaki varsayılan
# LLM_* istemcisini kullanır (geriye uyumlu, davranış değişmez). Bu istemci
# hata verirse (429/5xx/ağ/413/json_validate) aynı çağrı bir kez varsayılan
# istemciyle tekrar denenir.
DISTINCTIVENESS_LLM_BASE_URL=
DISTINCTIVENESS_LLM_API_KEY=
DISTINCTIVENESS_LLM_MODEL=
# Kaç kez oylanacağı (#181, PO kararı 2026-09-23): kart ANCAK TÜM oylar blok
# (K1|K2) derse bloklanır; oylar ayrışırsa kart YAZILIR ve "tartışmalı"
# işaretlenir. Geçersiz/boş/<1 -> 1, >5 -> 5. Varsayılan 1 = bugünkü
# davranışla BİREBİR aynı (tek çağrı); ölçüm sonrası yükseltilir.
DISTINCTIVENESS_VOTES=

# --- Çıktı dili -------------------------------------------------------------
# Üretilen kullanıcıya dönük metinler (problem_statement, tema açıklamaları,
# chat yanıtları) bu dilde üretilir. Alıntılar orijinal (EN) kalır, domain_tags
# kanonik EN slug'dır, build-prompt EN üretilir. Varsayılan: tr
OUTPUT_LANG=tr

# --- Connector'lar (opsiyonel) ----------------------------------------------
# Stack Exchange app key — auth şart değil, quota'yı artırır (Faz 0)
STACKEXCHANGE_KEY=
# GitHub PAT — 60/saat -> 5000/saat (Faz 1)
GITHUB_TOKEN=
# Product Hunt developer token (Faz 1)
PRODUCTHUNT_TOKEN=

# --- Reddit: wired ama UYKUDA -----------------------------------------------
# "Responsible Builder Policy" nedeniyle yeni script-app OAuth onayı şu an
# verilmiyor. Erişim açılırsa bu 4 değişken doldurulur, connector aktifleşir.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Pipeline ayarları ------------------------------------------------------
# Idea synthesis frekans eşiği: en az bu kadar post'u olan temalardan idea üretilir
MIN_THEME_EVIDENCE=3
# Classification batch (chunk) boyutu
LLM_CHUNK_SIZE=8
# Chunk'lar arası sabit sleep (ms) — "sakin ilerleme" prensibi
LLM_SLEEP_MS=400

# --- Özellik bayrakları (api servisi) ---------------------------------------
# Sohbetten kart türetme ("blend", ai_blended) — PO kararı 2026-09-24 (#186):
# özellik şimdilik KAPALI, kod SİLİNMEDİ. "true"/"1"/"yes" (büyük/küçük harf
# duyarsız, boşluk kırpılır) açar; boş/başka her şey KAPALI. Varsayılan KAPALI.
BLEND_ENABLED=

# --- Faz 2 (auth) — şimdilik boş bırakılabilir ------------------------------
# Virgülle ayrık admin allowlist'i; girişte idempotent kontrol edilir
ADMIN_EMAILS=
# App-JWT imza anahtarı (7 gün, refresh yok)
JWT_SECRET=
